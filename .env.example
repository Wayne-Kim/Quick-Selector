# quick-desktop configuration. Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit it.

# ─── Apple Developer ────────────────────────────────────────────────────────
# Team ID from your "Developer ID Application" certificate.
#   security find-identity -v -p codesigning | grep "Developer ID Application"
APPLE_TEAM_ID=AB12CD3456

# Reverse-DNS bundle identifier for the .app
APPLE_BUNDLE_ID=com.yourname.quickdesktop

# Keychain profile name used by `xcrun notarytool`.
# Set it up once with:
#   xcrun notarytool store-credentials "<profile>" \
#     --apple-id "<your-apple-id>" --team-id "<team-id>" --password "<app-specific-password>"
NOTARY_KEYCHAIN_PROFILE=quickdesktop-notary

# ─── GitHub ─────────────────────────────────────────────────────────────────
# Owner (user or org) and repository for releases / appcast hosting.
GITHUB_OWNER=your-github-username
GITHUB_REPO=quick-desktop

# Personal Access Token with `repo` scope.
# Used by release.sh for `git push` and `gh release create`.
#   Generate at https://github.com/settings/tokens (classic) with `repo` scope.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Sparkle ────────────────────────────────────────────────────────────────
# Ed25519 public key generated by tools/sparkle/bin/generate_keys.
# Private key is stored in your macOS Keychain by the generator.
SPARKLE_PUBLIC_KEY=YourBase64PublicKeyHere==
